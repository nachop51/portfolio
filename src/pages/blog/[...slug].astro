---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, fmtDate } from '../../lib/posts';

export async function getStaticPaths() {
	return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} ogType="article">
	<article>
		<h1>{post.data.title}</h1>
		<p class="muted">
			<time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
			{post.data.tags.length > 0 && ` · ${post.data.tags.join(', ')}`}
		</p>
		<Content />
	</article>
</Base>
